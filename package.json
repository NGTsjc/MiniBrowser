{
  "name": "minibrowser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite --host 127.0.0.1",
    "build:ui": "tsc --noEmit && vite build",
    "build": "tauri build --no-bundle && node scripts/package.mjs",
    "build:debug": "pnpm build:ui && cargo build --manifest-path src-tauri/Cargo.toml --features custom-protocol --locked",
    "check": "tsc --noEmit",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:smoke": "node scripts/smoke.mjs",
    "test:release": "node scripts/release-smoke.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
