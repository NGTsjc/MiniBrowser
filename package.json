{
  "name": "minibrowser",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite --host 127.0.0.1",
    "build:ui": "tsc --noEmit && vite build",
    "build": "tauri build --no-bundle -- --locked && node scripts/package.mjs",
    "build:debug": "pnpm build:ui && cargo build --manifest-path src-tauri/Cargo.toml --features custom-protocol --locked",
    "check": "tsc --noEmit",
    "test:unit": "tsc --strict --target ES2022 --module ES2022 --skipLibCheck --outDir .cache/unit src/preview.ts && node --test scripts/tests/sync-version.test.mjs scripts/tests/preview.test.mjs",
    "test:maintenance": "node scripts/tests/maintenance.mjs",
    "test:performance": "node scripts/tests/performance.mjs",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:smoke": "node scripts/tests/smoke.mjs",
    "test:release": "node scripts/tests/release-smoke.mjs",
    "tauri": "tauri",
    "version:set": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
